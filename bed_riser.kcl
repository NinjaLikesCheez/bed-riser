@settings(kclVersion = 2.0)

// ----- Parameters -----
baseW = 200mm   // base width (short axis)
baseL = 400mm   // base length (elongated axis)
topW = 90mm     // top width (short axis)
topL = 180mm    // top length (elongated axis)
height = 150mm  // riser height

notchW = 30mm     // width of the cross notch that grips the bed leg
notchDepth = 20mm // how deep the notch cuts down from the top face

// ----- Base profile (on XY, centered at origin) -----
baseProfile = startSketchOn(XY)
  |> startProfile(at = [-baseL / 2, -baseW / 2])
  |> line(endAbsolute = [baseL / 2, -baseW / 2])
  |> line(endAbsolute = [baseL / 2, baseW / 2])
  |> line(endAbsolute = [-baseL / 2, baseW / 2])
  |> close()

// ----- Top profile (on a plane at `height`, centered at origin) -----
topPlane = offsetPlane(XY, offset = height)

topProfile = startSketchOn(topPlane)
  |> startProfile(at = [-topL / 2, -topW / 2])
  |> line(endAbsolute = [topL / 2, -topW / 2])
  |> line(endAbsolute = [topL / 2, topW / 2])
  |> line(endAbsolute = [-topL / 2, topW / 2])
  |> close()

// ----- Loft the two profiles into a frustum -----
frustum = loft([baseProfile, topProfile])

// ----- Cross-shaped notch cut into the top face -----
// A "+" shaped pocket, sized to straddle a bed leg, cut `notchDepth` down from the top.
notchArmLen = topL / 2 + 10mm // extends past the top face edges so the cut is clean

notchSketch = startSketchOn(topPlane)
  |> startProfile(at = [-notchW / 2, -notchArmLen])
  |> line(endAbsolute = [notchW / 2, -notchArmLen])
  |> line(endAbsolute = [notchW / 2, -notchW / 2])
  |> line(endAbsolute = [notchArmLen, -notchW / 2])
  |> line(endAbsolute = [notchArmLen, notchW / 2])
  |> line(endAbsolute = [notchW / 2, notchW / 2])
  |> line(endAbsolute = [notchW / 2, notchArmLen])
  |> line(endAbsolute = [-notchW / 2, notchArmLen])
  |> line(endAbsolute = [-notchW / 2, notchW / 2])
  |> line(endAbsolute = [-notchArmLen, notchW / 2])
  |> line(endAbsolute = [-notchArmLen, -notchW / 2])
  |> line(endAbsolute = [-notchW / 2, -notchW / 2])
  |> close()

notchCut = extrude(notchSketch, length = -notchDepth)

// ----- Final solid: frustum minus the cross notch -----
riser = subtract([frustum], tools = [notchCut])
