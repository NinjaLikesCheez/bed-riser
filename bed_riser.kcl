@settings(kclVersion = 2.0)

// ----- Parameters -----
baseW = 200mm   // base width (short axis)
baseL = 400mm   // base length (elongated axis)
socketW = 90mm  // socket opening width (short axis) - must fit the 9cm bed leg
socketL = 180mm // socket opening length (elongated axis) - must fit the 18cm bed leg
height = 150mm  // riser height

notchDepth = 20mm     // how deep the socket cuts down from the top face
wallThickness = 15mm  // thickness of the solid rim standing around the socket

// Top face is sized to the socket plus the wall on all sides, so the socket
// opening itself always stays exactly socketW x socketL.
topW = socketW + 2 * wallThickness // top width (short axis)
topL = socketL + 2 * wallThickness // top length (elongated axis)

// ----- Base profile (on XY, centered at origin) -----
base = sketch(on = XY) {
  line1 = line(start = [-baseL / 2, -baseW / 2], end = [baseL / 2, -baseW / 2])
  line2 = line(start = [baseL / 2, -baseW / 2], end = [baseL / 2, baseW / 2])
  line3 = line(start = [baseL / 2, baseW / 2], end = [-baseL / 2, baseW / 2])
  line4 = line(start = [-baseL / 2, baseW / 2], end = [-baseL / 2, -baseW / 2])

  coincident([line1.end, line2.start])
  coincident([line2.end, line3.start])
  coincident([line3.end, line4.start])
  coincident([line4.end, line1.start])
}

// ----- Top profile (on a plane at `height`, centered at origin) -----
topPlane = offsetPlane(XY, offset = height)

top = sketch(on = topPlane) {
  line1 = line(start = [-topL / 2, -topW / 2], end = [topL / 2, -topW / 2])
  line2 = line(start = [topL / 2, -topW / 2], end = [topL / 2, topW / 2])
  line3 = line(start = [topL / 2, topW / 2], end = [-topL / 2, topW / 2])
  line4 = line(start = [-topL / 2, topW / 2], end = [-topL / 2, -topW / 2])

  coincident([line1.end, line2.start])
  coincident([line2.end, line3.start])
  coincident([line3.end, line4.start])
  coincident([line4.end, line1.start])
}

// ----- Loft the two profiles into a frustum -----
frustum = loft([base, top])

// ----- Socket notch cut into the top face -----
// A socketW x socketL pocket, centered on the top face, leaving a continuous
// `wallThickness` rim standing around it.
notch = sketch(on = topPlane) {
  line1 = line(start = [-socketL / 2, -socketW / 2], end = [socketL / 2, -socketW / 2])
  line2 = line(start = [socketL / 2, -socketW / 2], end = [socketL / 2, socketW / 2])
  line3 = line(start = [socketL / 2, socketW / 2], end = [-socketL / 2, socketW / 2])
  line4 = line(start = [-socketL / 2, socketW / 2], end = [-socketL / 2, -socketW / 2])

  coincident([line1.end, line2.start])
  coincident([line2.end, line3.start])
  coincident([line3.end, line4.start])
  coincident([line4.end, line1.start])
}

notchCut = extrude(notch, length = -notchDepth)

// ----- Final solid: frustum minus the socket -----
riser = subtract([frustum], tools = [notchCut])
